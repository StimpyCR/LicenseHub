FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /source
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
COPY global.json Directory.Build.props ./
COPY backend/ backend/
COPY contracts/openapi/ contracts/openapi/
RUN dotnet restore backend/LicenseHub.slnx --locked-mode -p:NuGetAudit=false
RUN dotnet build backend/LicenseHub.slnx -c Release --no-restore -m:1 -p:UseSharedCompilation=false
ENTRYPOINT ["dotnet", "test", "--no-build", "--no-restore", "--configuration", "Release"]
CMD ["backend/LicenseHub.slnx"]
