FROM node:24-alpine AS build
WORKDIR /source
COPY frontend/licensehub-web/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/licensehub-web/ ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /source/dist/licensehub-web/browser /usr/share/nginx/html
EXPOSE 8443
